# Public Supabase browser configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Cloudflare R2 configuration
# Never prefix these secret values with VITE_.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_UPLOADS_BUCKET=yuva-udaan-uploads
R2_PUBLIC_BUCKET=yuva-udaan-public
R2_PUBLIC_URL=https://pub-example.r2.dev
